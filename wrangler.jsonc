{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jupygrader-cloud",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Custom entry: vinext's fetch handler plus Queue and Cron handlers for grading.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "vars": {
    // Public URL of the deployment, used for links in emails. `npm run dev` uses .dev.vars instead.
    "APP_URL": "https://jupygrader.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jupygrader",
      "database_id": "3e5ec116-4d36-4fe2-8aa7-82f6ded047b3",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "jupygrader-files"
    }
  ],
  "queues": {
    "producers": [{ "binding": "GRADING_QUEUE", "queue": "jupygrader-grading" }],
    "consumers": [
      {
        "queue": "jupygrader-grading",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 100,
        "max_concurrency": 10
      }
    ]
  },
  "triggers": {
    // Every minute: recover stuck jobs and grade queued files if no queue is bound.
    // Daily: delete submissions past the retention period and archive ended courses.
    "crons": ["* * * * *", "17 3 * * *"]
  },
  // nbconvert renders "Notebook as HTML" downloads (containers/nbconvert, worker/nbconvert.ts).
  // Containers need the Workers Paid plan. This account only allows the durable_object scheduling
  // policy, so worker/nbconvert.ts picks the image and instance size when it starts the container.
  // The image is built from containers/nbconvert and pushed to this account's Cloudflare registry
  // ahead of time, so deploys (including Workers Builds, which has no Docker) don't build it. To
  // change it, see "nbconvert container" in the README. Without the container, downloads use the
  // built-in HTML instead.
  "containers": [
    {
      "class_name": "Nbconvert",
      "scheduling_policy": "durable_object",
      "images": {
        "nbconvert": {
          // jupygrader-nbconvert:7.17.2-2
          "image": "registry.cloudflare.com/1739340826a42e1131ca2f53210cbdd4/jupygrader-nbconvert@sha256:a6cc776fc0ef3f753a4fa74b8999ea72732ca2e9421588bb94d7b56cbb54df26"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NBCONVERT", "class_name": "Nbconvert" }]
  },
  "exports": {
    "Nbconvert": { "type": "durable-object", "storage": "sqlite" }
  },
  "dev": {
    // Running the container locally needs Docker (and WSL on Windows). To try it, set this to true
    // and replace "image" above with "dockerfile": "./containers/nbconvert/Dockerfile", since
    // vite dev can't pull from the Cloudflare registry.
    "enable_containers": false
  },
  "observability": { "enabled": true },
  // Worker Previews: Workers Builds deploys one per pull request branch (npx wrangler preview) and
  // posts its URL on the pull request. Previews use staging resources, never production data.
  // - APP_URL is left unset, so links use the Preview's own address.
  // - Files aren't graded in Previews: Queue consumers and Cron Triggers only run in production.
  // - Notebook HTML uses the built-in renderer; the nbconvert container isn't bound.
  // - Secrets (BETTER_AUTH_SECRET, RESEND_API_KEY) are set under Builds > Previews Base in the dashboard.
  // Apply new migrations to the staging database with `npm run db:migrate:preview`.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "jupygrader-preview",
        "database_id": "ef87b0e0-69be-409b-b284-b6c00ba10854",
        "migrations_dir": "migrations"
      }
    ],
    "r2_buckets": [
      {
        "binding": "FILES",
        "bucket_name": "jupygrader-preview-files"
      }
    ]
  }
}
